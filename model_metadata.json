{
    "project_name": "AI-Powered Cybersecurity Threat Detection System",
    "version": "1.0.0",
    "author": "Cybersecurity & ML Engineer Student",
    "training_date": "2023-10-25",
    "models_trained": [
        "RandomForestClassifier",
